\newcommand{\BlueHeader}[1]{
    \noindent\colorbox{VereinsBlau}{\parbox{\dimexpr\textwidth-2\fboxsep}{
        \centering \color{white} \textbf{#1}
    }}\vspace{1em}
}
\newlength{\FooterHeight}
\newlength{\BallRadius}

\setlength{\FooterHeight}{1.2cm}
\setlength{\BallRadius}{0.9cm}\newcommand{\VereinsFooter}{%
  \begin{tikzpicture}[remember picture, overlay]

    % Mittelpunkt des Balls
    \coordinate (BallCenter) at
      ([yshift=\FooterHeight]current page.south);

    % 1. Blauer Balken (NICHT bis ganz unten)
    \fill[VereinsBlau]
      ([yshift=0.2cm]current page.south west)
      rectangle
      ([yshift=\FooterHeight]current page.south east);

    % 2. Loch für den Ball (Aussparung)
    \fill[white]
      (BallCenter) circle (\BallRadius);

    % 3. Fußball
    \node at (BallCenter) {%
      \includegraphics[width=1.8cm]{bilder/fussball_icon.png}%
    };

    % 4. Seitenzahl
    \node at (BallCenter) {%
      \sffamily\bfseries\Large\color{VereinsBlau}\thepage%
    };

  \end{tikzpicture}%
}
